# Supabase Environment Variables
# Vul deze in en hernoem naar .env.local voor lokale ontwikkeling
# Voor Vercel deployment: configureer deze in Vercel Project Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://[your-project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[your-anon-key]

# Optioneel: Service Role Key (alleen voor server-side operaties)
# SUPABASE_SERVICE_ROLE_KEY=[your-service-role-key]

# Database Connection Pool
DATABASE_URL=postgresql://postgres:[your-password]@db.[your-project-id].supabase.co:5432/postgres

# Nederlandse Business Configuratie
DEFAULT_COUNTRY=NL
DEFAULT_CURRENCY=EUR
DEFAULT_LANGUAGE=nl

# Security
JWT_SECRET=[your-jwt-secret]
ENCRYPTION_KEY=[your-encryption-key]